#!/bin/sh
set -e

case "$1" in
    purge)
        if getent passwd pi-piper >/dev/null; then
            deluser --system pi-piper >/dev/null 2>&1 || true
        fi
        if getent group pi-piper >/dev/null; then
            delgroup --system pi-piper >/dev/null 2>&1 || true
        fi
        rm -rf /var/lib/pi-piper /etc/pi-piper
        ;;
esac

#DEBHELPER#

exit 0
