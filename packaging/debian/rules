#!/usr/bin/make -f
export PYBUILD_NAME=pi-piper
export PYBUILD_DISABLE=test

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	install -D -m 0644 packaging/systemd/pi-piper.service \
	    debian/pi-piper/lib/systemd/system/pi-piper.service
	install -D -m 0644 src/pi_piper/data/config.example.yaml \
	    debian/pi-piper/usr/share/pi-piper/config.example.yaml
